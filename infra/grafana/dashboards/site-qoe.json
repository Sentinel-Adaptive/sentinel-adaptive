          },
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT site_id, bucket_start, qoe_score, qoe_availability, qoe_latency_factor, qoe_capacity, latency_p95, nxdomain_ratio, saturation, qoe_explanation FROM sentinel.site_metrics ORDER BY bucket_start DESC LIMIT 1 BY site_id",
