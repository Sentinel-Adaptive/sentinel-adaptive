{
  "name": "sentinel-adaptive",
  "version": "0.0.0",
  "private": true,
  "description": "Context-aware DNS intelligence at the edge",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "compliance": "node scripts/verify-compliance.mjs",
    "health": "node scripts/healthcheck.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
